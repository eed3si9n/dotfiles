# export SITE_PACKAGES=$HOME/.local/lib/python2.7/site-packages/
export PATH=~/bin:~/dotfiles/bin:$PATH

## Ruby
## list all available versions
## $ rbenv install -l
## install a Ruby version
## $ rbenv install 2.0.0-p247
if [ $commands[rbenv] ]; then
  export PATH="$HOME/.rbenv/bin:$PATH"
  eval "$(rbenv init -)"
fi

## keyboard
# setxkbmap -option ctrl:swapcaps,altwin:swap_alt_win -model microsoft4000

## Java

if [ $commands[jenv] ]; then
  export PATH="$HOME/.jenv/bin:$PATH"
  eval "$(jenv init -)"
fi

# export JAVA_1_6_HOME="/usr/lib/jvm/java-1.6.0-openjdk-amd64"
# export JAVA_1_7_HOME="/usr/lib/jvm/java-1.7.0-openjdk-amd64"
# export JAVA_1_8_HOME="/usr/lib/jvm/java-8-oracle"

# Cargo
[ -s "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"
